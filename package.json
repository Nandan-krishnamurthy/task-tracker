{
  "name": "task-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-only personal task tracker. No account, no server, no sync.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
